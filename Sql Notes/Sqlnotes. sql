DELIMITER;
create procedure addrace
(
    in racename varchar(250),
    In racedate date,
    in racetracname varchar(250)
)
begin

declare racetrack_id_to_insert INT;

select racetrack_id
into racetrack_id_to_insert
from racetrack
where name = racetracname;

insert into race (racetrack_id, name, date)
values ( racetrack_id_to_insert, racename, racedate)

end

DELIMITER;


